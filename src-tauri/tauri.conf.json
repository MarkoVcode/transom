{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transom",
  "version": "1.12.0",
  "identifier": "dev.localnetdiag.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Transom",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNENBNDMzQTJDNTc3MzAKUldRd2Q4V2lNNlJNWWg3dk9GSjk0bXJYVDZIWWhUc3dLOERVbFZ3d3AwbEhLTzBxazl5empjNlUK",
      "endpoints": [
        "https://github.com/MarkoVcode/transom/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Repeatable local network discovery and diagnostics",
    "longDescription": "Discovers every device on your local network, identifies it, measures connectivity and Wi-Fi health, and tracks what changes between scans. Runs without administrator privileges.",
    "copyright": "MIT licensed",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
